<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#F5F5F5">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="24dp">

        <!-- Title -->

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Smart Parking Finder"

            android:textSize="30sp"

            android:textStyle="bold"

            android:textColor="#000"

            android:layout_marginBottom="20dp"/>

        <!-- Description -->

        <TextView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Smart Parking Finder is an Android-based smart parking management system developed using Java, Firebase Realtime Database, Leaflet.js, OpenStreetMap, and Android WebView. The application helps users locate nearby parking spaces, book slots, navigate using Google Maps, and manage bookings in real-time."

            android:textSize="16sp"

            android:textColor="#333"

            android:lineSpacingExtra="5dp"/>

        <!-- Features -->

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Features"

            android:textSize="24sp"

            android:textStyle="bold"

            android:textColor="#000"

            android:layout_marginTop="30dp"

            android:layout_marginBottom="12dp"/>

        <TextView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="• Live parking map\n• GPS location tracking\n• Smart parking booking\n• Booking history\n• Parking search\n• Admin dashboard\n• Real-time slot updates\n• Firebase integration\n• Google Maps navigation"

            android:textSize="16sp"

            android:textColor="#333"

            android:lineSpacingExtra="5dp"/>

        <!-- Technologies -->

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Technologies Used"

            android:textSize="24sp"

            android:textStyle="bold"

            android:textColor="#000"

            android:layout_marginTop="30dp"

            android:layout_marginBottom="12dp"/>

        <TextView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="• Android Studio\n• Java\n• Firebase Realtime Database\n• OpenStreetMap\n• Leaflet.js\n• HTML, CSS, JavaScript\n• Android WebView"

            android:textSize="16sp"

            android:textColor="#333"

            android:lineSpacingExtra="5dp"/>

        <!-- Footer -->

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Developed as MCA Final Year Project"

            android:textSize="16sp"

            android:textStyle="bold"

            android:textColor="#4CAF50"

            android:layout_marginTop="40dp"/>

    </LinearLayout>

</ScrollView>